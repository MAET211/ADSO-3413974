        <mxCell id="ent_rol" value="&lt;b&gt;ROL&lt;/b&gt;&lt;hr&gt;&lt;b&gt;&amp;lt;&amp;lt;PK&amp;gt;&amp;gt; id_rol : INT&lt;/b&gt;&#xa;nombre_rol : VARCHAR(40)&#xa;descripcion : VARCHAR(150)&#xa;nivel_acceso : INT&#xa;estado_activo : BOOLEAN" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#FFFFFF;strokeColor=#2B6CB0;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=11;" vertex="1" parent="1">
