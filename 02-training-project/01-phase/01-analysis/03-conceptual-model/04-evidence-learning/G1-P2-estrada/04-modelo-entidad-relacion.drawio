        <!-- Titulo y Metadatos -->
        <mxCell id="hdr_mer" value="SISTEMA GESTOR DE AMBULANCIAS (SGA) — MODELO ENTIDAD-RELACIÓN (MER)&#xa;Evidencia G1-P2 · RAP 592373 (Criterio C4) · Aprendiz: MAET211 (Carpeta: G1-P2-estrada) · Notación Pata de Gallo (Crow's Foot)" style="text;html=1;strokeColor=#2B6CB0;fillColor=#EBF8FF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="1100" height="45" as="geometry" />
        </mxCell>

        <!-- ==================== FILA 1 ==================== -->

