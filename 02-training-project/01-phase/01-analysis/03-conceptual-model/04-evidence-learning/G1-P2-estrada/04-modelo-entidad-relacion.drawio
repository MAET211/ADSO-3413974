          <mxGeometry x="520" y="710" width="310" height="170" as="geometry" />
        </mxCell>

        <!-- Leyenda -->
        <mxCell id="box_legend" value="&lt;b&gt;CONVENCIONES Y REGLAS DE ARBITRAJE (SEC. 7)&lt;/b&gt;&lt;hr&gt;• &lt;b&gt;Entidad Fuerte / Regular:&lt;/b&gt; Borde azul solido&#xa;• &lt;b&gt;Entidad Asociativa (N:M):&lt;/b&gt; Borde purpura con atributos propios&#xa;• &lt;b&gt;Entidad Débil Estricta:&lt;/b&gt; Borde punteado naranja, PK compuesta&#xa;  formada por (servicio_id + numero_secuencia)&#xa;• &lt;b&gt;Crow's Foot:&lt;/b&gt; (1,1) Lineas dobles | (0,N)/(1,N) Pata de gallo&#xa;• &lt;b&gt;Zero Spaghetti:&lt;/b&gt; Ruteo ortogonal y cardinalidad explicita" style="text;html=1;strokeColor=#CBD5E0;fillColor=#FFFFFF;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=0;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="710" width="415" height="170" as="geometry" />
        </mxCell>

