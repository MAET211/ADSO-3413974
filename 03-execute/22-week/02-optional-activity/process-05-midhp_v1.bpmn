        <di:waypoint x="1630" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1650" y="480" />
        <di:waypoint x="1650" y="580" />
        <di:waypoint x="1720" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1940" y="580" />
        <di:waypoint x="1990" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Participant_2_di" bpmnElement="Participant_2" isHorizontal="true">
        <dc:Bounds x="160" y="680" width="1900" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Publico_di" bpmnElement="StartEvent_Publico">
        <dc:Bounds x="220" y="722" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="199" y="765" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConsultaPublica_di" bpmnElement="Task_ConsultaPublica">
        <dc:Bounds x="300" y="700" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Publico_di" bpmnElement="EndEvent_Publico">
        <dc:Bounds x="560" y="722" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="541" y="765" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Pub1_di" bpmnElement="Flow_Pub1">
        <di:waypoint x="256" y="740" />
