        <!-- ==================== FILA 3 (ASOCIATIVA Y DÉBIL FORMAL) ==================== -->

        <!-- Entidad 9: HISTORIAL_ESTADOS_SERVICIO (DÉBIL CON CLAVE COMPUESTA ESTRICTA) -->
        <mxCell id="ent_historial" value="&lt;b&gt;HISTORIAL_ESTADOS_SERVICIO (Débil)&lt;/b&gt;&lt;hr&gt;&lt;b&gt;&amp;lt;&amp;lt;PK, FK&amp;gt;&amp;gt; servicio_id : INT (Identificadora)&lt;/b&gt;&#xa;&lt;b&gt;&amp;lt;&amp;lt;PK&amp;gt;&amp;gt; numero_secuencia : INT (Discriminador)&lt;/b&gt;&#xa;&lt;b&gt;&amp;lt;&amp;lt;FK&amp;gt;&amp;gt; usuario_responsable_id : INT&lt;/b&gt;&#xa;estado_anterior : VARCHAR(25)&#xa;estado_nuevo : VARCHAR(25)&#xa;fecha_hora_cambio : DATETIME&#xa;motivo_justificacion : VARCHAR(255)&#xa;origen_cambio : VARCHAR(30)" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=#FFFAF0;strokeColor=#DD6B20;strokeWidth=1.5;dashed=1;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;align=center;fontSize=11;" vertex="1" parent="1">
