      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Pub2_di" bpmnElement="Flow_Pub2">
        <di:waypoint x="520" y="740" />
        <di:waypoint x="560" y="740" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
